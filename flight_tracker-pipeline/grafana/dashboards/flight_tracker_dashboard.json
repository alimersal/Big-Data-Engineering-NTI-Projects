      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"flight-metrics\")\n  |> range(start: -20s)\n  |> filter(fn: (r) => r._measurement == \"flight_details\")\n  |> filter(fn: (r) =>\n      r._field == \"latitude\" or\n      r._field == \"longitude\" or\n      r._field == \"altitude_m\" or\n      r._field == \"velocity_kmh\"\n  )\n  |> group(columns: [\"icao24\", \"callsign\", \"country\", \"airline\", \"_field\"])\n  |> last()\n  |> group(columns: [\"icao24\", \"callsign\", \"country\", \"airline\"])\n  |> pivot(rowKey: [\"icao24\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> group()\n  |> filter(fn: (r) => exists r.latitude and exists r.longitude)\n  |> drop(columns: [\"_start\", \"_stop\", \"_measurement\"])"
        }
      ]

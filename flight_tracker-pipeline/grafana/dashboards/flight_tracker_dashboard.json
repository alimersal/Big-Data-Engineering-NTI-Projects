          "query": "from(bucket: \"flight-metrics\")\n  |> range(start: -20s)\n  |> filter(fn: (r) => r._measurement == \"country_metrics\")\n  |> filter(fn: (r) => r._field == \"flight_count\")\n  |> group(columns: [\"country\"])\n  |> last()\n  |> group()\n  |> filter(fn: (r) => r._value > 0)\n  |> sort(columns: [\"_value\"], desc: true)\n  |> limit(n: 10)\n  |> keep(columns: [\"_time\", \"country\", \"_value\"])\n  |> map(fn: (r) => ({_time: r._time, _field: r.country, _value: r._value}))\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"_field\"], valueColumn: \"_value\")"

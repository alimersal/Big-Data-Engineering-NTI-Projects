          { "matcher": { "id": "byName", "options": "latitude" },     "properties": [{ "id": "displayName", "value": "📍 Latitude" },      { "id": "decimals", "value": 2 }, { "id": "custom.width", "value": 80 }] },
          { "matcher": { "id": "byName", "options": "longitude" },    "properties": [{ "id": "displayName", "value": "📍 Longitude" },     { "id": "decimals", "value": 2 }, { "id": "custom.width", "value": 80 }] },
